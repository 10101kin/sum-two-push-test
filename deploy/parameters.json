{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "southeastasia"
    },
    "imageName": {
      "value": "sum-two"
    },
    "imageTag": {
      "value": "latest"
    },
    "prefix": {
      "value": "sumtwo"
    },
    "dnsNameLabel": {
      "value": "sumtwo-sea-demo"
    },
    "appPort": {
      "value": 80
    },
    "containerCpu": {
      "value": 1
    },
    "containerMemory": {
      "value": 1
    },
    "registryServer": {
      "value": "<your-registry>.azurecr.io"
    },
    "registryUsername": {
      "value": "<your-registry-username>"
    },
    "registryPassword": {
      "value": "<REPLACE>"
    }
  }
}
